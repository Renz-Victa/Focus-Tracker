{
  "manifest_version": 3,
  "name": "Focus Tracker",
  "version": "1.0.0",
  "description": "Track time on social media. Set limits. Stay focused.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "idle",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.linkedin.com/*",
    "*://*.reddit.com/*",
    "*://*.facebook.com/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.linkedin.com/*",
        "*://*.reddit.com/*",
        "*://*.facebook.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content/tracker.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_rules",
        "enabled": false,
        "path": "rules/block_rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
